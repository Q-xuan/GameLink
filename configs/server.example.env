# GameLink 服务器示例配置。
# 进程只提供明文 HTTP 和 UDP，不在这里终结 TLS，控制面不要设成 443。

# 控制面 HTTP 监听地址
GAMELINK_CONTROL_LISTEN=127.0.0.1:41080

# UDP 中继监听地址
GAMELINK_RELAY_LISTEN=0.0.0.0:41000

# 对外公布的控制面 URL。按实际部署填写，不要把某台机器的地址写进仓库。
GAMELINK_PUBLIC_CONTROL_URL=http://127.0.0.1:41080

# 对外公布的 UDP 中继地址，形式是 host:port。
GAMELINK_PUBLIC_RELAY=127.0.0.1:41000
