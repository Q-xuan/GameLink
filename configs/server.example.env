# GameLink 服务器示例配置。
# 进程只提供明文 HTTP 和 UDP，不在这里终结 TLS，控制面不要设成 443。

# 控制面 HTTP 监听地址
GAMELINK_CONTROL_LISTEN=127.0.0.1:41080

# UDP 中继监听地址
GAMELINK_RELAY_LISTEN=0.0.0.0:41000

# 对外公布的控制面 URL
GAMELINK_PUBLIC_CONTROL_URL=wss://gamelink.aruyx.com

# 对外公布的 UDP 中继地址
GAMELINK_PUBLIC_RELAY=195.72.187.81:41000
